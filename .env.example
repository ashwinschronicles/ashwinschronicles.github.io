# ==============================================================================
# Environment Configuration Template for Pelican (ashwinschronicles.github.io)
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================
# Active Environment Context: "production" or "test" (also accepts "branch-deploy")
CONTEXT=production

# ==============================================================================
# Production Environment Settings
# ==============================================================================
# Google Analytics Measurement ID (GA4: G-XXXXXXXXXX, or Universal Analytics: UA-XXXXXXXX-X)
GOOGLE_ANALYTICS_PROD=your_production_ga_id_here

# StatCounter Project ID (numeric ID from your StatCounter project snippet)
STAT_COUNTER_PROJECT_PROD=your_production_statcounter_project_id

# StatCounter Security Code (alphanumeric security string)
STAT_COUNTER_SECURITY_PROD=your_production_statcounter_security_code

# Optional Production Integrations
CLAIM_GOOGLE_PROD=
DISQUS_SITENAME=
HEAP_ANALYTICS_PROD=

# ==============================================================================
# Test / Staging Environment Settings
# ==============================================================================
# Test Google Analytics Measurement ID (for dev/testing without polluting prod metrics)
GOOGLE_ANALYTICS_TEST=your_test_ga_id_here
GOOGLE_ANALYTICS_NEXT=your_test_ga_id_here

# Test StatCounter Project ID and Security Code
STAT_COUNTER_PROJECT_TEST=your_test_statcounter_project_id
STAT_COUNTER_PROJECT_NEXT=your_test_statcounter_project_id
STAT_COUNTER_SECURITY_TEST=your_test_statcounter_security_code
STAT_COUNTER_SECURITY_NEXT=your_test_statcounter_security_code

# Optional Test Integrations
HEAP_ANALYTICS_NEXT=
COMMENTBOX_PROJECT=

# ==============================================================================
# Pelican Native / Direct Fallbacks
# ==============================================================================
# Standard Pelican and theme configuration variables (used if CONTEXT is omitted)
GOOGLE_ANALYTICS=your_production_ga_id_here

# Theme-specific StatCounter settings (Elegant and other Pelican themes)
STAT_COUNTER_PROJECT=your_production_statcounter_project_id
STAT_COUNTER_SECURITY=your_production_statcounter_security_code
STATCOUNTER_PROJECT=your_production_statcounter_project_id
STATCOUNTER_SECURITY=your_production_statcounter_security_code
